# Churn Early Warning Pipeline – Environment Variables
# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env in Git committen (siehe .gitignore).

# --- Datenquelle ---
# Pfad zur CSV-Datei mit Customer Events (relativ zum Projektroot)
CHURN_DATA_SOURCE=data/sample/customer_events_sample.csv

# --- Report-Konfiguration ---
# Anzahl der at-risk Accounts im Report (Standard: 20)
CHURN_TOP_N_ACCOUNTS=20

# Minimaler Risk Score für Aufnahme ins Ranking (0-100, Standard: 25)
CHURN_MIN_SCORE_THRESHOLD=25.0

# --- Logging ---
# Log-Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CHURN_LOG_LEVEL=INFO

# Optionaler Pfad für Log-Datei (leer = nur Konsole)
CHURN_LOG_FILE=

# --- Output ---
# Verzeichnis für generierte Reports (CSV, JSON)
CHURN_OUTPUT_DIR=output
